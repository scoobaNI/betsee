.env
.env.*
!.env.example
target/
node_modules/
dist/
__pycache__/
*.pyc
state/
# Generated from docs/design/tokens.css by init-env.
infra/keycloak/themes/betsee/login/resources/css/tokens.css

# Tauri regenerates its capability schemas on every build.
desk/src-tauri/gen/

# Launch film renders (film/render, film/audio/score.py). Captures and the paid ElevenLabs assets
# (voice takes, music, sound effects) stay tracked.
film/out/*
!film/out/vo/
!film/out/music/
!film/out/sfx/
# The live Director recordings: hundreds of MB of frames, re-recorded by film/capture/live.mjs.
film/captures/live/

# Public training datasets for the semantic classifier (tools/semantic-classifier/fetch_datasets.sh).
tools/semantic-classifier/corpus/public/
