{
  "format": "betsee-scenario/v0",
  "id": "act6-supply-chain-and-rogue",
  "act": 6,
  "title": "Supply chain and a rogue agent",
  "asi": ["ASI04", "ASI10"],
  "summary": "A drifted tool descriptor is blocked; a bursting agent is quarantined.",
  "sessions": {
    "maya-invoice": {
      "human": "maya",
      "agent": "invoice-assistant",
      "use_case": "invoice-processing",
      "delegated": [
        "crm.read",
        "files.read",
        "payments.transfer",
        "email.send"
      ],
      "tier_ceiling": "internal",
      "budget_cents": 5000
    },
    "maya-report": {
      "human": "maya",
      "agent": "report-bot",
      "use_case": "weekly-reporting",
      "delegated": ["crm.read", "llm.complete"],
      "tier_ceiling": "internal",
      "budget_cents": 120
    }
  },
  "steps": [
    {
      "step_id": "act6.s1",
      "kind": "tool_drift",
      "tool": "payments",
      "expect": {
        "event": "tool.descriptor_changed",
        "status": "blocked"
      },
      "narration": "The MCP server's payments descriptor changes; its description now hides an instruction. The pinned hash no longer matches: blocked.",
      "pace_ms": 1500
    },
    {
      "step_id": "act6.s2",
      "kind": "action",
      "session": "maya-invoice",
      "capability": "payments.transfer",
      "resource": {
        "type": "payment_account",
        "id": "payments/nordfreight-supplier",
        "tier": "internal"
      },
      "parameters": {
        "amount_cents": 50000,
        "currency": "EUR",
        "invoice": "INV-88240"
      },
      "expect": {
        "decision": "deny",
        "controls": ["CTL-TOOL-001"],
        "policies": ["forbid-tool-descriptor-drift"],
        "executed": false
      },
      "narration": "invoice-assistant tries a small payment through the drifted tool: deny before the tool is reached.",
      "pace_ms": 1200
    },
    {
      "step_id": "act6.s3",
      "kind": "action",
      "session": "maya-report",
      "capability": "crm.read",
      "resource_pattern": {
        "type": "crm_record",
        "id": "crm/customer-{n}",
        "tier": "internal",
        "n_from": 1001
      },
      "parameters": {},
      "repeat": 24,
      "expect_sequence": [
        {
          "from": 1,
          "to": 12,
          "decision": "allow"
        },
        {
          "from": 13,
          "to": 17,
          "decision": "deny",
          "controls": ["CTL-RUN-001"]
        },
        {
          "from": 18,
          "to": 24,
          "decision": "deny",
          "controls": ["CTL-ID-002"]
        }
      ],
      "expect_after": {
        "agent": "report-bot",
        "state": "quarantined"
      },
      "narration": "report-bot bursts through customer records. The session budget (120 cents at 10 cents a read) runs out after 12 reads; five denials trip the breaker; report-bot is quarantined and every later action denies.",
      "pace_ms": 150
    }
  ]
}
