{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Betsee Desk",
  "version": "0.1.0",
  "identifier": "ai.betsee.desk",
  "build": {
    "frontendDist": "../../web/apps/desk/dist",
    "devUrl": "http://localhost:1430",
    "beforeDevCommand": "npm --prefix ../web run dev -w @betsee/desk",
    "beforeBuildCommand": "npm --prefix ../web run build -w @betsee/desk"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Betsee Desk",
        "width": 1320,
        "height": 860,
        "minWidth": 980,
        "minHeight": 640,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:8097 ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
